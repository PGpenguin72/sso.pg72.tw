{
  "schemaVersion": 2,
  "packageRoots": [".", "apps/sso", "apps/test-rp", "wiki"],
  "environmentPolicy": {
    "exactValues": {
      "DAST_TARGET": "${{ vars.PGID_DAST_PREVIEW_ORIGIN }}",
      "DAST_ALLOWED_PREVIEW_ORIGIN": "${{ vars.PGID_DAST_PREVIEW_ORIGIN }}",
      "DAST_PREVIEW_OPT_IN": "${{ vars.PGID_DAST_PREVIEW_OPT_IN }}"
    },
    "safeStaticValues": {
      "CI": "1",
      "NO_COLOR": "1"
    },
    "allowedExpressionContexts": [
      "vars.PGID_DAST_PREVIEW_ORIGIN",
      "vars.PGID_DAST_PREVIEW_OPT_IN"
    ],
    "scopes": {
      "ci.yml": {
        "workflow": [],
        "jobs": { "verify": [] },
        "steps": {}
      },
      "dast-preview.yml": {
        "workflow": [],
        "jobs": {
          "safe-dast": [
            "DAST_TARGET",
            "DAST_ALLOWED_PREVIEW_ORIGIN",
            "DAST_PREVIEW_OPT_IN"
          ]
        },
        "steps": {}
      }
    }
  }
}
