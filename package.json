{
  "name": "pg72-id",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm test:clean-dist && pnpm --filter @pg72/id check && pnpm --filter @pg72/test-rp check",
    "check:copy-token": "pnpm --filter @pg72/copy-token-tests check",
    "dev": "pnpm --filter @pg72/id dev",
    "dev:rp": "pnpm --filter @pg72/test-rp dev",
    "test": "pnpm -r --if-present test",
    "test:clean-dist": "node --test scripts/clean-package-dist.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
