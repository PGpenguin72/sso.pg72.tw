{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off",
    "suspicious": "off"
  },
  "rules": {
    "typescript/no-floating-promises": [
      "error",
      { "ignoreIIFE": false, "ignoreVoid": false }
    ],
    "typescript/no-misused-promises": "error"
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/worker-configuration.d.ts"
  ]
}
