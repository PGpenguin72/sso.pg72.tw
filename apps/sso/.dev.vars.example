# Copy to .dev.vars for local development. Never commit the real values.
AUTH_BASE_URL="http://localhost:5173"
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:5173"
REGISTRATION_MODE="public"
ENVIRONMENT="development"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
BOOTSTRAP_ADMIN_EMAIL="you@example.com"

# --- Optional social login providers (placeholders) ---
# Each provider only activates when BOTH its id and secret are set. Leave these
# as placeholders locally; real values go into Wrangler secrets, never here.
# Developer-portal callback (redirect) URL to register for each provider:
#   Discord:  https://sso.pg72.tw/callback/discord
#   GitHub:   https://sso.pg72.tw/callback/github
#   Facebook: https://sso.pg72.tw/callback/facebook
#   Apple:    https://sso.pg72.tw/callback/apple
# Telegram uses the Login Widget (no OAuth callback); set the bot's domain to
# sso.pg72.tw in @BotFather and post the widget payload to /api/auth/telegram.
DISCORD_CLIENT_ID="placeholder-discord-client-id"
DISCORD_CLIENT_SECRET="placeholder-discord-client-secret"
GITHUB_CLIENT_ID="placeholder-github-client-id"
GITHUB_CLIENT_SECRET="placeholder-github-client-secret"
FACEBOOK_CLIENT_ID="placeholder-facebook-client-id"
FACEBOOK_CLIENT_SECRET="placeholder-facebook-client-secret"
# Apple's client secret is a short-lived ES256 JWT you generate from your Apple
# private key (Sign in with Apple); paste the current JWT here.
APPLE_CLIENT_ID="placeholder-apple-services-id"
APPLE_CLIENT_SECRET="placeholder-apple-client-secret-jwt"
APPLE_APP_BUNDLE_IDENTIFIER="tw.pg72.placeholder"
# Telegram bot token from @BotFather (format 123456:ABC...). Placeholder only.
TELEGRAM_BOT_TOKEN="123456:placeholder-telegram-bot-token"
